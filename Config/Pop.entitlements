<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Pop is intentionally NOT sandboxed: it drives Accessibility APIs on
	     other apps and controls system windows, neither of which the App
	     Sandbox permits. The absence of com.apple.security.app-sandbox here
	     is deliberate — adding it back would break the product. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Hardened runtime (codesign with the runtime option) DENIES microphone
	     access outright unless this entitlement is present, regardless of
	     sandbox state — the engine would run but capture silence and TCC would
	     never prompt. Proven by the jarvis_voice reference app on this
	     machine. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>